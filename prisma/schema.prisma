datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  BENEVOLE
  ADMIN
}

enum RegistrationStatus {
  DRAFT
  CONFIRMED
}

model Edition {
  id                 String           @id @default(uuid())
  year               Int              @unique
  name               String
  isCurrent             Boolean          @default(false)
  isRegistrationOpen    Boolean          @default(true)
  registrationStartDate DateTime?
  registrationEndDate   DateTime?
  eventStartDate        DateTime?
  eventEndDate          DateTime?
  eventDays             String[]         @default([])
  timeSlots          TimeSlot[]
  users              User[]
  invitationCodes    InvitationCode[]
  auditLogs          AuditLog[]
  missions           Mission[]
  createdAt          DateTime         @default(now())
}

model InvitationCode {
  id        String   @id @default(uuid())
  code      String   @unique
  email     String?
  isUsed    Boolean  @default(false)
  editionId String
  edition   Edition  @relation(fields: [editionId], references: [id])
  usedById  String?  @unique
  usedBy    User?    @relation("UsedInvitation", fields: [usedById], references: [id])
  createdAt DateTime @default(now())
}

model User {
  id               String             @id @default(uuid())
  email            String             @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String
  photoUrl         String?
  role             Role               @default(BENEVOLE)
  birthDate                DateTime?
  isMinor                  Boolean            @default(false)
  isApprovedMinor          Boolean            @default(false)
  parentalAuthorizationUrl String?
  minorValidationStatus    String             @default("NONE")
  isLocked                 Boolean            @default(false)
  planningStatus           RegistrationStatus @default(DRAFT)
  planningLockedAt         DateTime?

  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?

  editionId      String
  edition        Edition         @relation(fields: [editionId], references: [id])
  invitationCode InvitationCode? @relation("UsedInvitation")
  registrations  Registration[]
  auditLogs      AuditLog[]      @relation("AdminAudit")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Mission {
  id              String        @id @default(uuid())
  name            String
  description     String?
  color           String?
  isSensitive     Boolean       @default(false)
  isActive        Boolean       @default(true)
  defaultCapacity Int           @default(2)
  editionId       String
  edition         Edition       @relation(fields: [editionId], references: [id], onDelete: Cascade)
  slotMissions    SlotMission[]

  @@unique([name, editionId])
}

model TimeSlot {
  id           String        @id @default(uuid())
  date         DateTime
  startTime    String
  endTime      String
  orderIndex   Int
  editionId    String
  edition      Edition       @relation(fields: [editionId], references: [id])
  slotMissions SlotMission[]

  @@unique([date, startTime, editionId])
}

model SlotMission {
  id            String         @id @default(uuid())
  missionId     String
  timeSlotId    String
  capacityMax   Int
  mission       Mission        @relation(fields: [missionId], references: [id], onDelete: Cascade)
  timeSlot      TimeSlot       @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@unique([missionId, timeSlotId])
}

model Registration {
  id            String      @id @default(uuid())
  userId        String
  slotMissionId String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  slotMission   SlotMission @relation(fields: [slotMissionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([userId, slotMissionId])
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String
  admin     User     @relation("AdminAudit", fields: [adminId], references: [id])
  action    String
  targetId  String?
  details   String?
  editionId String
  edition   Edition  @relation(fields: [editionId], references: [id])
  createdAt DateTime @default(now())
}